{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "remoteHost",
            "type": "promptString",
            "description": "Remote card IP/hostname",
            "default": "192.168.1.50"
        },
        {
            "id": "remoteUser",
            "type": "promptString",
            "description": "Remote login username",
            "default": "root"
        },
        {
            "id": "captureDuration",
            "type": "promptString",
            "description": "Capture duration in seconds",
            "default": "30"
        },
        {
            "id": "capturePath",
            "type": "promptString",
            "description": "Capture output base path (no extension)",
            "default": "capture_run"
        }
    ],
    "tasks": [

        // ── BUILD ─────────────────────────────────────────────────────────────

        {
            "label": "APP TOP Monitoring - Build",
            "type": "shell",
            "command": "make cli",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "icon": {
                "id": "rocket",
                "color": "terminal.ansiGreen"
            }
        },

        {
            "label": "APP TOP Monitoring - Build Debug",
            "type": "shell",
            "command": "make debug",
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "icon": {
                "id": "bug",
                "color": "terminal.ansiMagenta"
            }
        },

        {
            "label": "APP TOP Monitoring - Build Release",
            "type": "shell",
            "command": "make release",
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "icon": {
                "id": "rocket",
                "color": "terminal.ansiGreen"
            }
        },

        // ── QT BUILD ──────────────────────────────────────────────────────────

        {
            "label": "APP TOP Monitoring - Qt Build",
            "type": "shell",
            "command": "make qt",
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "icon": {
                "id": "rocket",
                "color": "terminal.ansiCyan"
            }
        },

        {
            "label": "APP TOP Monitoring - Qt Debug Build",
            "type": "shell",
            "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build --target app_top_monitoring_qt",
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "icon": {
                "id": "bug",
                "color": "terminal.ansiMagenta"
            }
        },

        {
            "label": "APP TOP Monitoring - Qt Release Build",
            "type": "shell",
            "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build --target app_top_monitoring_qt",
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "icon": {
                "id": "rocket",
                "color": "terminal.ansiGreen"
            }
        },

        // ── CLEAN ─────────────────────────────────────────────────────────────

        {
            "label": "APP TOP Monitoring - Clean",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": [],
            "icon": {
                "id": "trash",
                "color": "terminal.ansiRed"
            }
        },

        {
            "label": "APP TOP Monitoring - Clean and Build",
            "type": "shell",
            "command": "make",
            "dependsOrder": "sequence",
            "dependsOn": [
                "APP TOP Monitoring - Clean"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "icon": {
                "id": "refresh",
                "color": "terminal.ansiGreen"
            }
        },

        {
            "label": "APP TOP Monitoring - Qt Clean and Build",
            "type": "shell",
            "command": "make qt",
            "dependsOrder": "sequence",
            "dependsOn": [
                "APP TOP Monitoring - Clean"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "icon": {
                "id": "refresh",
                "color": "terminal.ansiCyan"
            }
        },

        // ── CMAKE ─────────────────────────────────────────────────────────────

        {
            "label": "APP TOP Monitoring - CMake Configure",
            "type": "shell",
            "command": "cmake -S . -B build",
            "problemMatcher": [],
            "icon": {
                "id": "gear",
                "color": "terminal.ansiBlue"
            }
        },

        {
            "label": "APP TOP Monitoring - CMake Build",
            "type": "shell",
            "command": "cmake --build build",
            "dependsOn": [
                "APP TOP Monitoring - CMake Configure"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$gcc"
            ],
            "icon": {
                "id": "tools",
                "color": "terminal.ansiGreen"
            }
        },

        {
            "label": "APP TOP Monitoring - CMake Qt Build",
            "type": "shell",
            "command": "cmake --build build --target app_top_monitoring_qt",
            "dependsOn": [
                "APP TOP Monitoring - CMake Configure"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$gcc"
            ],
            "icon": {
                "id": "tools",
                "color": "terminal.ansiCyan"
            }
        },

        // ── RUN CLI ───────────────────────────────────────────────────────────

        {
            "label": "APP TOP Monitoring - Run",
            "type": "shell",
            "command": "./build/app_top_monitoring",
            "dependsOn": [
                "APP TOP Monitoring - Build"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "icon": {
                "id": "pulse",
                "color": "terminal.ansiCyan"
            }
        },

        {
            "label": "APP TOP Monitoring - Run One Shot",
            "type": "shell",
            "command": "./build/app_top_monitoring --once",
            "dependsOn": [
                "APP TOP Monitoring - Build"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "icon": {
                "id": "debug-stop",
                "color": "terminal.ansiYellow"
            }
        },

        {
            "label": "APP TOP Monitoring - Run Long Args",
            "type": "shell",
            "command": "./build/app_top_monitoring --long-args",
            "dependsOn": [
                "APP TOP Monitoring - Build"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "icon": {
                "id": "list-tree",
                "color": "terminal.ansiCyan"
            }
        },

        {
            "label": "APP TOP Monitoring - Run CPU Sort",
            "type": "shell",
            "command": "./build/app_top_monitoring --sort cpu",
            "dependsOn": [
                "APP TOP Monitoring - Build"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "icon": {
                "id": "graph",
                "color": "terminal.ansiGreen"
            }
        },

        {
            "label": "APP TOP Monitoring - Run Memory Sort",
            "type": "shell",
            "command": "./build/app_top_monitoring --sort mem",
            "dependsOn": [
                "APP TOP Monitoring - Build"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "icon": {
                "id": "graph",
                "color": "terminal.ansiYellow"
            }
        },

        {
            "label": "APP TOP Monitoring - Run Bash",
            "type": "shell",
            "command": "./build/app_top_monitoring bash",
            "dependsOn": [
                "APP TOP Monitoring - Build"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "icon": {
                "id": "terminal",
                "color": "terminal.ansiCyan"
            }
        },

        // ── REMOTE (SSH / Telnet / FTP / TFTP) ──────────────────────────────────
        // Host/user are prompted for each run rather than hardcoded. See
        // REMOTE_TESTING.md for setting up local test servers for each protocol.

        {
            "label": "APP TOP Monitoring - Run SSH",
            "type": "shell",
            "command": "./build/app_top_monitoring --protocol ssh --host ${input:remoteHost} --user ${input:remoteUser}",
            "dependsOn": [
                "APP TOP Monitoring - Build"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "icon": {
                "id": "radio-tower",
                "color": "terminal.ansiCyan"
            }
        },

        {
            "label": "APP TOP Monitoring - Run Telnet",
            "type": "shell",
            "command": "./build/app_top_monitoring --protocol telnet --host ${input:remoteHost} --user ${input:remoteUser}",
            "dependsOn": [
                "APP TOP Monitoring - Build"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "icon": {
                "id": "plug",
                "color": "terminal.ansiYellow"
            }
        },

        {
            "label": "APP TOP Monitoring - Deploy FTP",
            "type": "shell",
            "command": "./build/app_top_monitoring --protocol ftp --host ${input:remoteHost} --user ${input:remoteUser} --local-file ./build/app_top_monitoring",
            "dependsOn": [
                "APP TOP Monitoring - Build"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "icon": {
                "id": "cloud-upload",
                "color": "terminal.ansiGreen"
            }
        },

        {
            "label": "APP TOP Monitoring - Deploy TFTP",
            "type": "shell",
            "command": "./build/app_top_monitoring --protocol tftp --host ${input:remoteHost} --local-file ./build/app_top_monitoring",
            "dependsOn": [
                "APP TOP Monitoring - Build"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "icon": {
                "id": "cloud-upload",
                "color": "terminal.ansiYellow"
            }
        },

        // ── CAPTURE ───────────────────────────────────────────────────────────

        {
            "label": "APP TOP Monitoring - Capture (N seconds)",
            "type": "shell",
            "command": "./build/app_top_monitoring --capture=${input:captureDuration} --capture-output ${input:capturePath}",
            "dependsOn": [
                "APP TOP Monitoring - Build"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "icon": {
                "id": "graph-line",
                "color": "terminal.ansiMagenta"
            }
        },

        {
            "label": "APP TOP Monitoring - Capture (until Ctrl+C)",
            "type": "shell",
            "command": "./build/app_top_monitoring --capture --capture-output ${input:capturePath}",
            "dependsOn": [
                "APP TOP Monitoring - Build"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "icon": {
                "id": "graph-line",
                "color": "terminal.ansiBlue"
            }
        },

        {
            "label": "APP TOP Monitoring - Open Latest Capture Report",
            "type": "shell",
            "command": "xdg-open \"$(ls -t capture_*.html \"${input:capturePath}.html\" 2>/dev/null | head -1)\"",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "icon": {
                "id": "link-external",
                "color": "terminal.ansiBlue"
            }
        },

        // ── RUN QT ────────────────────────────────────────────────────────────

        {
            "label": "APP TOP Monitoring - Run Qt",
            "type": "shell",
            "command": "./build/app_top_monitoring_qt",
            "options": {
                "env": {
                    "QT_QPA_PLATFORM": "xcb"
                }
            },
            "dependsOn": [
                "APP TOP Monitoring - Qt Build"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "icon": {
                "id": "window",
                "color": "terminal.ansiCyan"
            }
        },

        {
            "label": "APP TOP Monitoring - Run Qt Debug",
            "type": "shell",
            "command": "./build/app_top_monitoring_qt",
            "dependsOn": [
                "APP TOP Monitoring - Qt Debug Build"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "icon": {
                "id": "bug",
                "color": "terminal.ansiMagenta"
            }
        },

        // ── INSTALL ───────────────────────────────────────────────────────────

        {
            "label": "APP TOP Monitoring - Install",
            "type": "shell",
            "command": "make install",
            "dependsOn": [
                "APP TOP Monitoring - Build"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "icon": {
                "id": "cloud-upload",
                "color": "terminal.ansiCyan"
            }
        },

        // ── FORMAT ────────────────────────────────────────────────────────────

        {
            "label": "APP TOP Monitoring - Format C",
            "type": "shell",
            "command": "clang-format -i src/*.c inc/*.h",
            "problemMatcher": [],
            "icon": {
                "id": "symbol-color",
                "color": "terminal.ansiGreen"
            }
        },

        {
            "label": "APP TOP Monitoring - Format Qt",
            "type": "shell",
            "command": "clang-format -i src/qt/*.cpp inc/qt/*.h",
            "problemMatcher": [],
            "icon": {
                "id": "symbol-color",
                "color": "terminal.ansiCyan"
            }
        },

        {
            "label": "APP TOP Monitoring - Format All",
            "type": "shell",
            "command": "clang-format -i src/*.c inc/*.h src/qt/*.cpp inc/qt/*.h",
            "problemMatcher": [],
            "icon": {
                "id": "symbol-color",
                "color": "terminal.ansiGreen"
            }
        }
    ]
}
